{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loki:pr-context-related:1:input",
  "title": "Caller supplied seed for pr-context-related/1",
  "type": "object",
  "required": [
    "schema",
    "repo",
    "title",
    "text",
    "source_uri",
    "revision",
    "captured_at"
  ],
  "properties": {
    "schema": {
      "const": "pr-context-related/1"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 100000
    },
    "source_uri": {
      "type": "string",
      "description": "HTTPS or URN provenance, preserved exactly including query and fragment; no URL userinfo credentials. This URI is not fetched."
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorized_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Explicit caller authority, including repo; defaults to repo only. Case-insensitive duplicates are refused.",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    }
  },
  "additionalProperties": false
}
