{
  "modules": [
    "./plugin-register.mjs"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/capabilities/runtime/node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/onboarding-state.mjs\" --desktop-session-start"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^kaijan:(demo|mod-demo)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/capabilities/runtime/node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/demo-profile.mjs\" --hook kaijan"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/capabilities/runtime/node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/demo-profile.mjs\" --hook kaijan"
          }
        ]
      }
    ]
  }
}
