      "selected": "Direct/guided change review and work-item risk",
      "removed": "Standalone capturePr acquisition moved"
    },
    {
      "component": "Work Verifier",
      "selected": "Default supplied-evidence preparation/assessment/projection and shared binding",
      "removed": "No additional evaluator found; stale representation type narrowed"
    },
    {
      "component": "UI Modeler",
      "selected": "Focused live-folder generation, current framework source handling, current map read/export/provenance",
      "removed": "Event pilot, event retrieval, old page/control generation, archive/revision/CLI capture, independent compiler/review helpers and old graph validator moved"
    },
    {
      "component": "Browser Runner",
      "selected": "Native computer-use/official observations, preparation/traces/lifecycle",
      "removed": "No old JEV/memory/replay method present"
    },
    {
      "component": "macOS Runner",
      "selected": "Native desktop/AX/Appium path",
      "removed": "Unused initializer removed; execution algorithm unchanged"
    },
    {
      "component": "Context Intake / source adapters / contracts",
      "selected": "Original retained input, explicit adapters, provenance and Unicode-safe continuation",
      "removed": "Only unused root byte writers/comparator moved; supported standalone filter retained"
    },
    {
      "component": "Provider transport",
      "selected": "Serialized direct OpenAI Luna and OpenRouter JEV/catalog requests",
      "removed": "Gateway flags/convenience/embeddings APIs and old fixture moved"
    },
    {
      "component": "Local MCP / Setup / reports / Map Reader",
      "selected": "Current catalog, real Setup, current native and retained read/report contracts",
      "removed": "Context-only server, controlled Flow/standalone Setup, old CLI generator skill/package selection and obsolete provider harness moved"
    },
    {
      "component": "Core MCP",
      "selected": "Authorized connection status, exact Work Item read and disconnect",
      "removed": "No experimental capability engine found in this MCP route"
    },
    {
      "component": "Capability runtime / package",
      "selected": "Current installation/session and installed-payload verification; concrete Desktop/Crew APIs remain shared",
