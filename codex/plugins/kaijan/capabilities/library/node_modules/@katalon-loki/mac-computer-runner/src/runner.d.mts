type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

export interface RunOptions {
  /** Trusted host settings. Native analysis keeps its separate packaged pins. */
  model?: "gpt-6.1-terra" | undefined;
  reasoning?: "low" | "medium" | undefined;
  apiKey?: string | undefined;
  requestAI?:
    | ((
        body: Record<string, unknown>,
        signal: AbortSignal,
      ) => Promise<Response>)
    | undefined;
  artifactDirectory?: string;
  signal?: AbortSignal;
  limits?: { calls?: number; desktopInputs?: number; ms?: number };
  secretParameterNames?: string[];
  onEvent?: (event: Json) => void;
}

/** Requires a full scenario, explicit params, and target.app (bundle ID). */
export function run(input: unknown, options: RunOptions): Promise<Json>;
export function runScenario(config: unknown): Promise<Json>;
