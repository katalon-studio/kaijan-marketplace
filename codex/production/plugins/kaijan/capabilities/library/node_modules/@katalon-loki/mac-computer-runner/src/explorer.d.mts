import type { createRetainedAgentRunner } from "@katalon-experiments/ai-client/agents";
import type { explorePlanningTarget } from "@katalon-loki/computer-runner/explorer";

type PlanningOptions = Parameters<typeof explorePlanningTarget>[0];
export function exploreDesktopPlanningTarget(
  options: Omit<PlanningOptions, "target"> & {
    target: { app: string; launch?: boolean | undefined };
    outputDir: string;
  },
): ReturnType<typeof explorePlanningTarget>;

export function exploreDesktopApplication(
  options: Pick<PlanningOptions, "input" | "settings" | "saveArtifact"> &
    Partial<
      Pick<
        PlanningOptions,
        | "params"
        | "secretParameterNames"
        | "signal"
        | "finishSignal"
        | "testData"
        | "timeLimitMs"
      >
    > & {
      target: { app: string; launch?: boolean | undefined };
      outputDir: string;
      objective: string;
      engine: Pick<ReturnType<typeof createRetainedAgentRunner>, "run">;
      onEvent?: (event: { type: string; id?: string; name?: string }) => void;
    },
): Promise<{
  observedAt: string;
  objective: string;
  observations: { status: "complete" | "incomplete"; reason: string };
  explorationMap: PlanningOptions["input"];
  screenshots: PlanningOptions["input"][];
  evidence: PlanningOptions["input"][];
  actionCount: number;
}>;
