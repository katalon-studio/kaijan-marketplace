declare const profileOwner: unique symbol;
export interface RunOwnedBrowserProfile {
  readonly [profileOwner]: true;
}
/** Create a fresh owned profile; reject an existing path without changing it. */
export function createRunOwnedBrowserProfile(
  directory: string,
): Promise<RunOwnedBrowserProfile>;
/** Host-only cleanup. A cloned or fabricated owner cannot authorize removal. */
export function retireRunOwnedBrowserProfile(
  owner: RunOwnedBrowserProfile | undefined,
  options?: { cleanupVerified?: boolean; diagnosticConsumer?: string },
): Promise<{
  status: "removed" | "retained";
  reason?: string;
  holding?: string;
  code?: string;
}>;

export function prepareBrowser(options?: {
  signal?: AbortSignal;
  timeoutMs?: number;
  onOutput?: (text: string) => void;
}): Promise<{
  browser: "chromium";
  playwrightVersion: string;
  executablePath: string;
  executableAlreadyPresent: boolean;
}>;
