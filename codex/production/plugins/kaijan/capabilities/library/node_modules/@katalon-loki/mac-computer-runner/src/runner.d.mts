import type {
  RequestClarification,
  ApplicationContextTool,
  RunOptions as SharedRunOptions,
} from "@katalon-loki/computer-runner";
type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

export interface RunOptions {
  /** Trusted host settings. Native analysis keeps its separate packaged pins. */
  model?: "gpt-6.1-terra" | "gpt-6-luna" | undefined;
  reasoning?: "none" | "low" | "medium" | "high" | "xhigh" | "max" | undefined;
  effortRecovery?: boolean;
  runnerAssessment?: boolean;
  assessmentRecap?: boolean;
  requestClarification?: RequestClarification;
  applicationContext?: ApplicationContextTool;
  reviewRun?: SharedRunOptions["reviewRun"];
  reportSignal?: AbortSignal;
  apiKey?: string | undefined;
  providerSession?: SharedRunOptions["providerSession"];
  requestAI?:
    | ((
        body: Record<string, unknown>,
        signal: AbortSignal,
      ) => Promise<Response>)
    | undefined;
  artifactDirectory?: string;
  signal?: AbortSignal;
  limits?: { calls?: number; desktopInputs?: number; ms?: number };
  secretParameterNames?: string[];
  onEvent?: (event: Json) => void;
}

/** Requires a full scenario, explicit params, and target.app (bundle ID). */
export function run(input: unknown, options: RunOptions): Promise<Json>;
export function runScenario(config: unknown): Promise<Json>;
