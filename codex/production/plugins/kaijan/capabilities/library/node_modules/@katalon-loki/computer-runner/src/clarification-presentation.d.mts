export type ClarificationPresentation = {
  kind: "missing-value" | "app-choice" | "permission" | "task-scope";
  subject: { sourceId: string; quote: string };
  choices: { sourceId: string; quote: string }[];
};
export function parseClarificationSourceId(id: string): {
  kind: "task" | "parameter" | "application";
  sha256: string;
  index?: number;
  path?: string;
  field?: string;
};
export function renderClarificationPresentation(
  value: unknown,
  resolve: (
    sourceId: string,
  ) =>
    | { kind: string; text: string }
    | undefined
    | Promise<{ kind: string; text: string } | undefined>,
): Promise<{ kind: ClarificationPresentation["kind"]; question: string }>;
