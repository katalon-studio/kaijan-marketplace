type Binding = { sourceId: string; quote: string };
export type ClarificationPresentation =
  | {
      kind: "missing-value" | "app-choice" | "permission" | "task-scope";
      subject: Binding;
      choices: Binding[];
    }
  | {
      kind: "read-only-path";
      subject: Binding;
      control: Binding;
      choices: Binding[];
    };
export function parseClarificationSourceId(id: string): {
  kind: "task" | "parameter" | "application";
  sha256: string;
  index?: number;
  path?: string;
  field?: string;
};
export function renderClarificationPresentation(
  value: unknown,
  resolve: (
    sourceId: string,
  ) =>
    | { kind: string; text: string }
    | undefined
    | Promise<{ kind: string; text: string } | undefined>,
): Promise<{
  kind: Exclude<ClarificationPresentation["kind"], "read-only-path">;
  question: string;
}>;
