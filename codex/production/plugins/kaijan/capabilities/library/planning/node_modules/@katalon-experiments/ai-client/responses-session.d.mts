import type { Connection } from "./index.mjs";

type RecordWebSocketFrame = (
  phase: "request" | "response",
  frame: string,
) => void | Promise<void>;

export function createManagedResponsesSession(options: {
  connection: Connection;
  storeResponses: boolean;
  omitContent?: boolean | (() => boolean);
  requestAI?: Parameters<typeof createResponsesSession>[0]["requestAI"];
  recordWebSocketFrame?: RecordWebSocketFrame;
}): ReturnType<typeof createResponsesSession> | undefined;

/** Run-owned conversation. Send serially and close after final reporting. */
export function createResponsesSession(options: {
  apiKey?: string | undefined;
  storeResponses?: boolean;
  requestAI?:
    | ((
        body: Record<string, unknown>,
        signal?: AbortSignal,
      ) => Promise<Response>)
    | undefined;
  managedWebSocket?:
    | {
        socketPath: string;
        headers: Record<string, string>;
        omitContent?: () => boolean;
      }
    | undefined;
  record?: ((event: Record<string, unknown>) => Promise<void>) | undefined;
  recordWebSocketFrame?: RecordWebSocketFrame | undefined;
}): {
  send(
    request: Record<string, unknown>,
    signal?: AbortSignal,
    options?: { review?: boolean; inactivityTimeoutMs?: number },
  ): Promise<Response>;
  close(): void;
};
