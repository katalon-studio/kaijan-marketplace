/** Create a fresh owned profile; reject an existing path without changing it. */
export function createRunOwnedBrowserProfile(directory: string): Promise<void>;

export function prepareBrowser(options?: {
  signal?: AbortSignal;
  timeoutMs?: number;
  onOutput?: (text: string) => void;
}): Promise<{
  browser: "chromium";
  playwrightVersion: string;
  executablePath: string;
  executableAlreadyPresent: boolean;
}>;
