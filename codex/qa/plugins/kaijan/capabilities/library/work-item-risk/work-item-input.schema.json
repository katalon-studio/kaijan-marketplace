{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-finder/work-item-input/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "captured_at", "sources", "coverage"],
  "properties": {
    "schema": {
      "const": "risk-finder/work-item-input/1"
    },
    "captured_at": {
      "type": ["string", "null"]
    },
    "work_item": {
      "type": ["object", "null"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "const": "intent"
          }
        }
      },
      "items": {
        "type": "object",
        "required": ["id", "kind", "text", "uri", "revision"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["intent", "context"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": ["string", "null"]
          },
          "revision": {
            "type": ["string", "null"]
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "uninspected_links": {},
    "freshness": {},
    "provenance": {}
  }
}
