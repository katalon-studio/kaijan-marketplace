{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-risk-finder/packet/4",
  "title": "Change Risk Finder Git change or provided snapshot packet v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "coverage", "files"],
  "properties": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "base_sha", "head_sha"],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[\\w.-]+/[\\w.-]+$"
            },
            "pull_request": {
              "type": "integer",
              "minimum": 1
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "snapshot_id", "manifest_sha256"],
          "properties": {
            "kind": {
              "const": "provided-snapshot"
            },
            "snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "coverage": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ],
      "description": "Caller-supplied coverage text or structured metadata, retained without normalization."
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "files": {},
    "context_sources": {
      "type": "array",
      "description": "Optional attributed source items. Text is preserved as its own citable source; source roles and supplied metadata remain distinct. Original record IDs are metadata; review citations use the native source catalog.",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "kind": {
            "enum": ["intent", "implementation", "context"]
          },
          "text": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "uri": {
            "type": ["string", "null"]
          },
          "revision": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "provided-snapshot"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["filename", "content", "sha256"],
              "properties": {
                "filename": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["filename"],
              "properties": {
                "filename": {
                  "type": "string",
                  "minLength": 1
                },
                "patch": {
                  "type": ["string", "null"],
                  "description": "Original textual patch, or absent/null/empty when textual evidence was not supplied. Zero reported counts are file metadata, not verified byte equality."
                },
                "additions": {
                  "type": "integer",
                  "minimum": 0
                },
                "deletions": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "previous_filename": {
                  "type": "string",
                  "minLength": 1
                },
                "sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "old_mode": {
                  "type": "string",
                  "pattern": "^[0-7]{6}$"
                },
                "new_mode": {
                  "type": "string",
                  "pattern": "^[0-7]{6}$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
