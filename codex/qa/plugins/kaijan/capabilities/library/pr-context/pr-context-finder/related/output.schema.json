{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loki:pr-context-related:1:output",
  "type": "object",
  "required": ["schema", "version", "status", "errors", "accounting"],
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": ["query_selection"]
          },
          {
            "required": ["contribution_selection"]
          }
        ]
      },
      "else": {
        "properties": {
          "accounting": {
            "properties": {
              "calls": {
                "maximum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["contribution_selection"]
        }
      },
      "then": {
        "properties": {
          "accounting": {
            "properties": {
              "calls": {
                "maximum": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["query_selection"]
        }
      },
      "then": {
        "properties": {
          "accounting": {
            "properties": {
              "calls": {
                "maximum": 2
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "contribution_selection": {
      "type": "object",
      "required": ["method", "status", "accounting"],
      "properties": {
        "method": {
          "const": "context-contributions/1"
        },
        "status": {
          "enum": [
            "not_started",
            "requested",
            "selected",
            "partial",
            "unavailable",
            "stopped"
          ]
        },
        "accounting": {
          "$ref": "#/properties/ranking_accounting"
        }
      },
      "additionalProperties": false
    },
    "query_selection": {
      "type": "object",
      "description": "Opt-in full-source query proposal; host source bindings and generated search hypotheses remain separate.",
      "required": [
        "method",
        "status",
        "limits",
        "accounting",
        "semantic_support"
      ],
      "properties": {
        "method": {
          "enum": ["source-intent/1", "intent-search/1", "intent-search/2"]
        },
        "status": {
          "enum": [
            "not_started",
            "requested",
            "selected",
            "uncertain",
            "unavailable",
            "unusable"
          ]
        },
        "limits": {
          "type": "object"
        },
        "accounting": {
          "$ref": "#/properties/ranking_accounting"
        },
        "semantic_support": {
          "const": "model_assertion_requires_review"
        },
        "profile": {
          "type": "object"
        },
        "source": {
          "type": "object"
        },
        "routing": {
          "type": "object",
          "required": [
            "requested_method",
            "fallback_policy",
            "chosen_method",
            "original_query_outcome",
            "reason"
          ],
          "properties": {
            "requested_method": {
              "const": "intent-search/2"
            },
            "fallback_policy": {
              "enum": ["none", "deterministic"]
            },
            "chosen_method": {
              "enum": ["intent-search/2", "seed-lexical/2", null]
            },
            "original_query_outcome": {
              "enum": [
                "not_started",
                "selected",
                "uncertain",
                "unusable",
                "unavailable"
              ]
            },
            "original_model_status": {
              "enum": ["selected", "uncertain", "unrecognized", null]
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "identity": {
          "type": "object"
        },
        "model_status": {
          "enum": ["selected", "uncertain", "unrecognized"]
        }
      },
      "additionalProperties": false
    },
    "ranking_accounting": {
      "allOf": [
        {
          "$ref": "#/properties/accounting"
        },
        {
          "properties": {
            "calls": {
              "maximum": 1
            }
          }
        }
      ]
    },
    "source_screen": {
      "type": "object",
      "required": [
        "contract",
        "credential_env_names",
        "policy",
        "unbound_credentials"
      ],
      "properties": {
        "contract": {
          "const": "pcf-source-screen/2"
        },
        "credential_env_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "const": "exact-bound-values-and-URI-userinfo-password"
        },
        "unbound_credentials": {
          "const": "not_assessed"
        }
      },
      "additionalProperties": false
    },
    "github_transport": {
      "type": "object",
      "required": ["route", "protocol", "physical_request_count", "pagination"],
      "properties": {
        "route": {
          "const": "connected"
        },
        "protocol": {
          "enum": [
            "pcf-github-get/1",
            "pcf-github-get/2",
            "pcf-github-get/3",
            "pcf-github-get/4"
          ]
        },
        "physical_request_count": {
          "type": "null"
        },
        "pagination": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "schema": {
      "const": "pr-context-related/1"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": ["complete", "partial", "unavailable", "stopped", "refused"]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed": {
      "type": "object",
      "required": ["repo", "kind", "title", "url"],
      "properties": {
        "repo": {
          "type": "string"
        },
        "kind": {
          "enum": ["pr", "issue", "supplied"]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "url",
          "state",
          "direct_links",
          "relation",
          "retrieval_rank",
          "key",
          "repo",
          "number",
          "relationship_type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": ["pr", "issue"]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "state": {
            "enum": ["open", "closed"]
          },
          "direct_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "source_uri", "explanation"],
              "properties": {
                "type": {
                  "enum": ["literal_reference", "timeline_cross_reference"]
                },
                "source_uri": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                },
                "depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                },
                "via_issue_key": {
                  "type": "string"
                },
                "source_evidence_id": {
                  "type": "string",
                  "pattern": "^D[1-2]$"
                }
              }
            }
          },
          "relation": {
            "enum": ["specific", "broad", "unsupported", "unjudged"]
          },
          "reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieval_rank": {
            "type": "integer",
            "minimum": 1
          },
          "semantic_support": {
            "const": "model_assertion_requires_review"
          },
          "semantic_rank": {
            "type": "integer",
            "minimum": 1
          },
          "bm25_rank": {
            "type": ["integer", "null"]
          },
          "key": {
            "type": "string",
            "description": "Lowercase full owner/repository#number"
          },
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "admission_score": {
            "type": "integer",
            "minimum": 0,
            "description": "Static pool admission heuristic, never a semantic relation or calibrated score."
          },
          "relationship_type": {
            "enum": [
              "same_work",
              "explicit_fix",
              "explicit_reference",
              "adjacent_capability",
              "shared_vocabulary",
              "unsupported",
              "unjudged"
            ],
            "description": "Typed model claim; structural citation validation is not semantic or behavioral proof."
          },
          "semantic_rank_scope": {
            "enum": ["returned_subset_only", "all_selected_candidates"]
          },
          "primary_source_binding": {
            "type": "object",
            "required": [
              "method",
              "origin",
              "evidence_id",
              "source_uri",
              "revision",
              "sha256"
            ],
            "properties": {
              "method": {
                "const": "host-primary-source/1"
              },
              "origin": {
                "const": "host_derived_from_validated_candidate_id"
              },
              "evidence_id": {
                "type": "string"
              },
              "source_uri": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source_uri",
          "revision",
          "sha256",
          "omitted_characters"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_uri": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "omitted_characters": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "repo",
        "cache",
        "candidate_count",
        "inspected_count",
        "unjudged",
        "omissions",
        "failures",
        "boundaries",
        "authorized_repositories",
        "repository_coverage",
        "budget",
        "uninspected_references",
        "admission",
        "followthrough"
      ],
      "properties": {
        "candidate_selection": {
          "type": "object",
          "description": "Optional incoming-reference or model contribution selection audit. Identity and quotation binding do not establish semantic support."
        },
        "authorized_repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "repository_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "requests",
              "stages",
              "candidate_count",
              "selected_count",
              "channels"
            ],
            "properties": {
              "repo": {
                "type": "string"
              },
              "requests": {
                "type": "integer",
                "minimum": 0
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["stage", "status"]
                }
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 0
              },
              "selected_count": {
                "type": "integer",
                "minimum": 0
              },
              "channels": {
                "type": "object",
                "required": [
                  "timeline",
                  "literal_reference",
                  "recent",
                  "search"
                ],
                "properties": {
                  "timeline": {
                    "$ref": "#/$defs/admissionChannel"
                  },
                  "literal_reference": {
                    "$ref": "#/$defs/admissionChannel"
                  },
                  "recent": {
                    "$ref": "#/$defs/admissionChannel"
                  },
                  "search": {
                    "$ref": "#/$defs/admissionChannel"
                  }
                }
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "required": [
            "github_requests",
            "max_github_requests",
            "max_discovered",
            "max_candidates",
            "max_literal_fetches",
            "max_ranking_calls",
            "max_classification_calls"
          ]
        },
        "uninspected_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "repo",
              "number",
              "channel",
              "source_uri",
              "reason"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "channel": {
                "enum": ["literal_reference", "timeline", "recent", "search"]
              },
              "source_uri": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "repository_not_authorized",
                  "global_candidate_limit",
                  "literal_fetch_limit",
                  "acquisition_unavailable",
                  "authored_intake_quarantine"
                ]
              }
            }
          }
        },
        "unjudged": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "repo",
              "number",
              "url",
              "kind",
              "title",
              "relation"
            ],
            "properties": {
              "relation": {
                "const": "unjudged"
              }
            }
          }
        },
        "admission": {
          "type": "object",
          "required": ["method", "score", "memory"]
        },
        "retrieval": {
          "type": "object",
          "required": [
            "method",
            "terms",
            "phrases",
            "groups",
            "omitted_terms",
            "omitted_phrases",
            "selection_order",
            "search_order",
            "search_scope",
            "semantic_judgment"
          ],
          "properties": {
            "method": {
              "enum": [
                "seed-lexical/2",
                "source-intent/1",
                "intent-search/1",
                "intent-search/2"
              ]
            },
            "terms": {
              "type": "array",
              "maxItems": 48,
              "items": {
                "type": "object"
              }
            },
            "phrases": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object"
              }
            },
            "groups": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string"
                }
              }
            },
            "omitted_terms": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "omitted_phrases": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        },
        "followthrough": {
          "type": "object",
          "required": [
            "mode",
            "intake",
            "status",
            "reserved_requests",
            "max_issues",
            "max_depth",
            "ambiguous",
            "matches",
            "expanded",
            "skipped",
            "selection",
            "selection_limits",
            "judgments",
            "omitted"
          ],
          "properties": {
            "mode": {
              "enum": ["off", "matching"]
            },
            "intake": {
              "enum": ["deterministic", "jev"]
            },
            "status": {
              "enum": [
                "pending",
                "disabled",
                "seed_already_expanded",
                "ambiguous_many_matches",
                "semantic_candidates",
                "unresolved_parent_evidence",
                "no_supported_parent_in_batch",
                "semantic_selection_not_requested",
                "insufficient_followthrough_budget",
                "no_admitted_issues",
                "no_bounded_parent_input"
              ]
            },
            "reserved_requests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "max_issues": {
              "const": 2
            },
            "max_depth": {
              "const": 2
            },
            "ambiguous": {
              "type": "boolean"
            },
            "matches": {
              "type": "array"
            },
            "expanded": {
              "type": "array",
              "maxItems": 2
            },
            "skipped": {
              "type": "array"
            }
          }
        },
        "source_privacy": {
          "type": "object",
          "required": [
            "mode",
            "coverage",
            "derived_pages",
            "omitted_records",
            "lineage"
          ],
          "properties": {
            "mode": {
              "const": "quarantine-records"
            },
            "coverage": {
              "enum": ["partial", "original_admitted_bodies"]
            },
            "derived_pages": {
              "type": "integer",
              "minimum": 0
            },
            "omitted_records": {
              "type": "integer",
              "minimum": 0
            },
            "lineage": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "authored_input": {
          "type": "object",
          "required": ["role", "interpretation", "subject_provenance"],
          "properties": {
            "role": {
              "const": "subject"
            },
            "interpretation": {
              "type": "string"
            },
            "subject_provenance": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "search_coverage": {
          "$ref": "#/$defs/searchCoverage"
        },
        "reference_parsing": {
          "type": "array"
        },
        "comment_origin_filter": {
          "$ref": "#/$defs/commentOriginFilter"
        }
      }
    },
    "ranking": {
      "type": "object",
      "required": ["retrieval", "semantic", "calibrated", "coverage"],
      "properties": {
        "calibrated": {
          "const": false
        },
        "coverage": {
          "type": "object",
          "required": [
            "method",
            "status",
            "selected_count",
            "assessed_count",
            "unassessed_count",
            "order_scope",
            "items"
          ],
          "properties": {
            "method": {
              "const": "validated-judgment-coverage/1"
            },
            "status": {
              "enum": ["not_evaluated", "partial", "complete"]
            },
            "selected_count": {
              "type": "integer",
              "minimum": 0
            },
            "assessed_count": {
              "type": "integer",
              "minimum": 0
            },
            "unassessed_count": {
              "type": "integer",
              "minimum": 0
            },
            "order_scope": {
              "enum": [
                "not_evaluated",
                "returned_subset_only",
                "all_selected_candidates"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "candidate_id",
                  "key",
                  "status",
                  "reason",
                  "reported_rank"
                ],
                "properties": {
                  "candidate_id": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "status": {
                    "enum": ["assessed", "unassessed"]
                  },
                  "reason": {
                    "enum": [
                      "validated_model_row",
                      "model_judgment_missing",
                      "not_evaluated"
                    ]
                  },
                  "reported_rank": {
                    "type": ["integer", "null"],
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "github_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint", "started_at", "status", "elapsed_ms"]
      }
    },
    "comment_filter": {
      "type": "object",
      "description": "Requested JEV mode with actual deterministic/native coverage. A complete workflow never proves human authorship.",
      "required": [
        "mode",
        "calls",
        "known_cost_usd",
        "unknown_cost_calls",
        "batches",
        "policy_configured",
        "content_classification",
        "authorship_proven",
        "records_examined",
        "deterministic_only_records",
        "jev_classified_records",
        "retained_without_content_classification",
        "pending_records"
      ],
      "properties": {
        "mode": {
          "enum": ["actor-only", "jev"]
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "known_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "unknown_cost_calls": {
          "type": "integer",
          "minimum": 0
        },
        "batches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "policy_configured": {
          "type": ["boolean", "null"],
          "description": "Null before intake; false for an absent or empty actor exclusion configuration."
        },
        "content_classification": {
          "enum": [
            "not_started",
            "deterministic_only",
            "native_jev",
            "incomplete",
            "native_decisions"
          ]
        },
        "authorship_proven": {
          "const": false
        },
        "records_examined": {
          "type": "integer",
          "minimum": 0
        },
        "deterministic_only_records": {
          "type": "integer",
          "minimum": 0
        },
        "jev_classified_records": {
          "type": "integer",
          "minimum": 0
        },
        "retained_without_content_classification": {
          "type": "integer",
          "minimum": 0
        },
        "pending_records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "accounting": {
      "type": "object",
      "required": ["calls", "known_cost_usd", "unknown_cost_calls"],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "known_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "unknown_cost_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "usage": {
          "type": ["object", "null"]
        },
        "unknown_usage_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string"
    },
    "parent_selection": {
      "type": "object",
      "description": "Separate opt-in native JEV parent relevance accounting; does not prove semantic accuracy. Unknown first attempt stops continuation.",
      "required": [
        "mode",
        "calls",
        "known_cost_usd",
        "unknown_cost_calls",
        "unknown_usage_calls"
      ],
      "properties": {
        "mode": {
          "const": "jev"
        },
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "known_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "unknown_cost_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "unknown_usage_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "literal_references": {
      "type": "array",
      "maxItems": 200,
      "description": "Admitted source mentions, independent of semantic candidates. Known quarantined identities are removed.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "repo",
          "number",
          "url",
          "retrieved",
          "provenance",
          "omitted_provenance",
          "relation",
          "relationship_type"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/(issues|pull)/[1-9][0-9]*$"
          },
          "retrieved": {
            "type": "boolean"
          },
          "provenance": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "object",
              "required": [
                "type",
                "source_uri",
                "source_text_sha256",
                "captured_at",
                "depth"
              ],
              "properties": {
                "type": {
                  "const": "literal_reference"
                },
                "source_uri": {
                  "type": "string"
                },
                "source_text_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "captured_at": {
                  "type": "string"
                },
                "depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                }
              },
              "additionalProperties": false
            }
          },
          "omitted_provenance": {
            "type": "integer",
            "minimum": 0
          },
          "relation": {
            "const": "unjudged"
          },
          "relationship_type": {
            "const": "unjudged"
          }
        },
        "additionalProperties": false
      }
    },
    "partial_capture": {
      "type": "object",
      "required": [
        "coverage",
        "authorized_repositories",
        "github_requests",
        "max_github_requests",
        "search_coverage",
        "seed_rechecked",
        "omitted_literal_mentions",
        "limitation"
      ],
      "properties": {
        "coverage": {
          "const": "partial"
        },
        "authorized_repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "github_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_github_requests": {
          "type": "integer",
          "minimum": 1
        },
        "search_coverage": {
          "$ref": "#/$defs/searchCoverage"
        },
        "seed_rechecked": {
          "type": "boolean"
        },
        "omitted_literal_mentions": {
          "type": "integer",
          "minimum": 0
        },
        "limitation": {
          "type": "string"
        },
        "uninspected_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "repo",
              "number",
              "channel",
              "source_uri",
              "reason"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "channel": {
                "enum": ["literal_reference", "timeline", "recent", "search"]
              },
              "source_uri": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "repository_not_authorized",
                  "global_candidate_limit",
                  "literal_fetch_limit",
                  "acquisition_unavailable",
                  "authored_intake_quarantine"
                ]
              }
            }
          }
        },
        "search_feedback": {
          "type": "object"
        },
        "reference_parsing": {
          "type": "array"
        },
        "comment_origin_filter": {
          "$ref": "#/$defs/commentOriginFilter"
        }
      },
      "additionalProperties": false
    },
    "ranking_identity": {
      "type": "object"
    },
    "resource_preflight": {
      "type": "object"
    },
    "comment_origin_batches": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of private comment-origin batch artifacts written by this operation; not a proof of human/AI authorship."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "admissionChannel": {
      "type": "object",
      "required": [
        "fetched",
        "quarantined",
        "seed_excluded",
        "eligible_unique",
        "admitted",
        "dropped",
        "identity_quarantined"
      ],
      "properties": {
        "fetched": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0
        },
        "seed_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_unique": {
          "type": "integer",
          "minimum": 0
        },
        "admitted": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        },
        "identity_quarantined": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "fetched counts metadata observations including reuse and duplicates; admitted/dropped count unique identities per channel at final pool. API calls are separate."
    },
    "searchCoverage": {
      "type": "object",
      "required": [
        "requested_kinds",
        "retrieved_kinds",
        "omitted_kinds",
        "queries"
      ],
      "properties": {
        "requested_kinds": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["issue", "pr"]
          }
        },
        "retrieved_kinds": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["issue", "pr"]
          }
        },
        "omitted_kinds": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["issue", "pr"]
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "query", "status"],
            "properties": {
              "kind": {
                "enum": ["issue", "pr"]
              },
              "query": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "not_inspected",
                  "requested",
                  "retrieved",
                  "omitted",
                  "failed"
                ]
              },
              "reason": {
                "type": "string"
              },
              "phase": {
                "enum": ["initial", "relaxed"]
              },
              "observed_items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "retained_in_scope": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "source_document_self_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "eligible_non_seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "query_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the original query expression when partial identity state substitutes its non-source placeholder. Does not authorize replay."
              }
            },
            "additionalProperties": false
          }
        },
        "lexical_planning": {
          "$ref": "#/$defs/lexicalPlanning"
        }
      },
      "additionalProperties": false
    },
    "lexicalPlanning": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "query_character_budget",
        "omitted_group_occurrences",
        "semantic_coverage"
      ],
      "properties": {
        "status": {
          "enum": ["bounded", "partial", "unassessed"]
        },
        "reason": {
          "type": "string"
        },
        "query_character_budget": {
          "type": "integer",
          "minimum": 1
        },
        "omitted_group_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_coverage": {
          "const": "unassessed"
        }
      },
      "additionalProperties": false
    },
    "generationObservation": {
      "type": "object",
      "required": [
        "property",
        "span_start_codepoints",
        "span_end_codepoints",
        "content_sha256",
        "declaration_sha256",
        "classification",
        "declaration_kind"
      ],
      "properties": {
        "property": {
          "enum": ["title", "body", "text"]
        },
        "span_start_codepoints": {
          "type": "integer",
          "minimum": 0
        },
        "span_end_codepoints": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "declaration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classification": {
          "enum": ["uncertain", "explicit_automated", "explicit_generated"]
        },
        "declaration_kind": {
          "enum": ["automated_creation", "AI_generation"]
        }
      },
      "additionalProperties": false
    },
    "commentOrigin": {
      "type": "object",
      "required": [
        "schema",
        "enabled",
        "exclude",
        "reasons",
        "actor_type",
        "app_attribution",
        "status",
        "app_attribution_unknown",
        "device_origin",
        "AI_authorship"
      ],
      "properties": {
        "schema": {
          "const": "loki.github-comment-origin/1"
        },
        "enabled": {
          "type": "boolean"
        },
        "exclude": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": ["github_bot_actor", "github_app_attribution"]
          }
        },
        "actor_type": {
          "type": ["string", "null"]
        },
        "app_attribution": {
          "enum": [
            "identified",
            "explicit_null",
            "invalid_metadata",
            "not_supplied"
          ]
        },
        "status": {
          "enum": [
            "identified_bot_or_app",
            "user_account_origin_unverified",
            "unknown"
          ]
        },
        "app_attribution_unknown": {
          "type": "boolean"
        },
        "device_origin": {
          "const": "unknown"
        },
        "AI_authorship": {
          "const": "unassessed"
        }
      },
      "additionalProperties": false
    },
    "commentEligibility": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "mode",
        "role",
        "decision",
        "reason",
        "policy_sha256",
        "module_sha256",
        "original_record_sha256",
        "policy_provided",
        "policy_configured",
        "unknown_author",
        "comment_origin",
        "content_provenance",
        "authorship_proven",
        "coverage"
      ],
      "properties": {
        "schema": {
          "const": "loki.authored-record-eligibility/1"
        },
        "version": {
          "type": "string"
        },
        "mode": {
          "const": "actor-only"
        },
        "role": {
          "const": "comment"
        },
        "decision": {
          "enum": ["retain", "quarantine"]
        },
        "reason": {
          "type": "string"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "module_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_provided": {
          "type": "boolean"
        },
        "policy_configured": {
          "type": "boolean"
        },
        "unknown_author": {
          "type": "boolean"
        },
        "comment_origin": {
          "$ref": "#/$defs/commentOrigin"
        },
        "content_provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generationObservation"
          }
        },
        "authorship_proven": {
          "const": false
        },
        "coverage": {
          "const": "supplied_record_mechanical_only"
        },
        "observed_generation_provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generationObservation"
          }
        }
      },
      "additionalProperties": false
    },
    "commentOriginBatch": {
      "type": "object",
      "required": ["label", "records_examined", "decisions"],
      "properties": {
        "label": {
          "type": "string"
        },
        "records_examined": {
          "type": "integer",
          "minimum": 0
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commentEligibility"
          }
        }
      },
      "additionalProperties": false
    },
    "commentOriginFilter": {
      "type": "object",
      "required": ["enabled", "batches", "AI_authorship", "device_origin"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commentOriginBatch"
          }
        },
        "AI_authorship": {
          "const": "unassessed"
        },
        "device_origin": {
          "const": "unknown"
        }
      },
      "additionalProperties": false
    }
  }
}
