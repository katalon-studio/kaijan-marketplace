import type { ClientRequest, IncomingMessage, RequestOptions } from "node:http";
export {
  AiClientError,
  providerConnection,
  requireManagedBinding,
} from "./litellm-route.mjs";
export interface Connection {
  url: string;
  headers: Record<string, string>;
  socketPath?: string;
}
export function sendFetch(
  connection: Connection,
  options: RequestInit,
  transport?: typeof fetch,
): Promise<Response>;
export function requestHttp(
  connection: Connection,
  options: RequestOptions,
  callback: (response: IncomingMessage) => void,
  transport?: (
    url: string,
    options: RequestOptions,
    callback: (response: IncomingMessage) => void,
  ) => ClientRequest,
): ClientRequest;
/** Luna standard-tier usage estimate, not a billing receipt; invalid usage is null. */
export function lunaUsageEstimate(usage: unknown): number | null;

/** Supported Luna/Terra standard-tier estimate; unknown models/usage return null. */
export function responsesUsageEstimate(
  usage: unknown,
  model: string,
): number | null;

/** Stateless inference and, for OpenRouter, ZDR provider selection. */
export function zdrRequest<T extends Record<string, unknown>>(
  body: T,
  provider?: "openai" | "openrouter",
): T & { store: false };
