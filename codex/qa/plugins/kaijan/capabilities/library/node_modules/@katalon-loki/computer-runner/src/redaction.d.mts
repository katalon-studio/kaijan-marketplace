export interface RunnerRedactor {
  readonly revision: number;
  addSecrets(values: unknown[]): void;
  hasSecret(value: unknown): boolean;
  text(value: unknown): string;
  value(value: unknown): unknown;
}
export function redactor(values?: unknown[]): RunnerRedactor;
export class RunnerProjectionError extends Error {
  code: string;
  constructor(code?: string);
}
export function redactionRecord(redact: RunnerRedactor): {
  schema: "loki.runner.safe-projection/1";
  revision: number;
};
export function projectClarification<T>(request: T, redact: RunnerRedactor): T;
export function projectTerminal<T>(terminal: T, redact: RunnerRedactor): T;
export function projectRunnerResult<T>(
  result: T,
  redact: RunnerRedactor,
  stamp?: boolean,
): T;
export function projectRunnerProgress<T>(
  event: T,
  redact: RunnerRedactor,
  issued?: { functions?: string[]; actions?: string[] },
):
  | T
  | {
      error: {
        schema: "loki.runner.safe-projection-error/1";
        code: "unsafe_model_identity";
      };
      redaction: { schema: "loki.runner.safe-projection/1"; revision: number };
    };
export function projectRunnerUi<T>(observation: T, redact: RunnerRedactor): T;

export function clarificationAnswerSecrets(answer: unknown): string[];
