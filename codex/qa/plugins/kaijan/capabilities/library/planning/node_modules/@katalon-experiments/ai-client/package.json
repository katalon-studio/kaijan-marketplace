{
  "name": "@katalon-experiments/ai-client",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAI Responses and Decisions with retained OpenRouter JEV transport",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./agents": {
      "types": "./agents.d.mts",
      "import": "./agents.mjs"
    },
    "./responses-session": {
      "types": "./responses-session.d.mts",
      "import": "./responses-session.mjs"
    }
  },
  "files": [
    "index.mjs",
    "broker-channel.mjs",
    "index.d.mts",
    "litellm-route.mjs",
    "litellm-route.d.mts",
    "README.md",
    "agents.mjs",
    "agents.d.mts",
    "responses-session.mjs",
    "responses-session.d.mts",
    "retention.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@openai/agents-core": "0.21.0",
    "@openai/agents-openai": "0.21.0",
    "openai": "7.45.0"
  }
}
