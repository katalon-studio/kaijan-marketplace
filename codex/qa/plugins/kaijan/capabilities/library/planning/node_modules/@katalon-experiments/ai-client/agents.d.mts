import type { Runner } from "@openai/agents-core";
export { Agent, computerTool, tool } from "@openai/agents-core";
import type {
  Response,
  ResponseCreateParamsNonStreaming,
} from "openai/resources/responses/responses";

export class RetainedResponseNotAdmitted extends Error {}

export interface RetainedAgentRunnerOptions {
  model: string;
  store: boolean;
  /** Retain original request/response and failures before returning or throwing. */
  dispatch: (
    request: ResponseCreateParamsNonStreaming,
    options: { signal?: AbortSignal },
  ) => Promise<Response>;
}

/** Creates an SDK execution engine; it does not define another product agent. */
export function createRetainedAgentRunner(
  options: RetainedAgentRunnerOptions,
): Runner;

/** Uses the Runner agent for one request and returns the host's retained reply. */
export function requestComputerActionTurn<
  T extends { response: { ok: boolean }; body: Response | null },
>(options: {
  request: ResponseCreateParamsNonStreaming;
  signal?: AbortSignal;
  dispatch: () => Promise<T>;
  isTerminal?: (output: Response["output"]) => boolean;
}): Promise<T>;
